# Copy to .env and fill in. `.env` is gitignored; never commit real values.
# Sourced by ./prod.sh. Shell env always overrides .env.

# Required. Generate with: npm run hash-password -- '<password>'
CHORELENGER_PASSWORD_HASH=

# Listen address and port. 3000 is bombos2 and 3001 is mem-alice on the same phone.
HOST=127.0.0.1
PORT=3002

# Session cookie marked Secure (site is served over HTTPS via Cloudflare Tunnel).
COOKIE_SECURE=1

# SQLite database path (relative to the repo root).
CHORELENGER_DB=data/chorelenger.db

# Timezone used to decide what "today" is.
# TZ=<IANA zone, e.g. Europe/London>
